; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Evron"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="Evron"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[shader_globals]

brush={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
political_map={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
political_palette={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
political_on={
"type": "float",
"value": 1.0
}
political_top={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
political_selected={
"type": "int",
"value": 0
}
river_hl_on={
"type": "float",
"value": 0.0
}
area_map={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
area_palette={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
area_gray={
"type": "float",
"value": 0.0
}
area_on={
"type": "float",
"value": 0.0
}
wall_index={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
wall_segments={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
wall_on={
"type": "float",
"value": 0.0
}
coast_map={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
satellite_optics={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
satellite_river_atlas={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
satellite_optics_on={
"type": "float",
"value": 0.0
}
satellite_rivers_on={
"type": "float",
"value": 0.0
}

satellite_water_preview={
"type": "sampler2D",
"value": "res://shaders/political_default.tres"
}
satellite_water_region={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[gui]

timers/tooltip_delay_sec=0.25

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=10
